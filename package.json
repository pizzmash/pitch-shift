{
  "name": "pitchshift",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm test && npm run build",
    "spec:validate": "npm exec --yes --package=node@22 --package=@fission-ai/openspec@1.13.0 -- openspec validate --all --strict",
    "test:browser": "npm run build && node scripts/test-browser.mjs",
    "test:extension": "npm run build && node scripts/smoke-extension.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.1.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
